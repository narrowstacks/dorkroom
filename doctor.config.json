{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": ["**/supabase/functions/**", "tools/oxlint/anti-slop/**"],
    "rules": [
      "deslop/unused-file",
      "deslop/unused-export",
      "deslop/unused-dependency",
      "deslop/unused-dev-dependency",
      "react-doctor/no-high-complexity-react-function",
      "react-doctor/duplicate-jsx-subtree"
    ]
  }
}
