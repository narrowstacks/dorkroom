# Dorkroom mobile environment — copy to `.env` (or set as an EAS secret) and fill in.
#
# Free-tier public Dorkroom API key (prefix `dk_f_`, 60 req/min, read-only public
# data). Inlined into the bundle at build time (EXPO_PUBLIC_* are NOT secret —
# extractable from a shipped app, which is acceptable here per the plan). Provision
# one at https://dorkroom.art and store it as an EAS secret for CI/production builds.
EXPO_PUBLIC_DORKROOM_API_KEY=dk_f_xxxxxxxxxxxxxxxxxxxxxxxx
