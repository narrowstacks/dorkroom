  "devDependencies": {
    "@types/react": "~19.2.14",
    "lucide-static": "^1.18.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": ["react-native-nitro-image"]
      }
    },
    "install": {
      "exclude": ["react", "react-dom"]
    }
  }
