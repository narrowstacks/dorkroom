    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/query-sync-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.12",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.9",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-media-library": "~57.0.3",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "lucide-react-native": "^1.18.0",
    "nativewind": "^4.2.6",
    "react": "19.2.7",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.5.1",
    "react-native-reorderable-list": "^0.18.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
