{
  "expo": {
    "name": "Dorkroom",
    "slug": "dorkroom",
    "scheme": "dorkroom",
    "version": "2026.7.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "art.dorkroom.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Dorkroom uses the camera to meter the light in your scene and to photograph negatives for the inverter.",
        "NSPhotoLibraryUsageDescription": "Choose a photo from your library to attach to a film log shot or to convert a negative to a positive.",
        "NSPhotoLibraryAddUsageDescription": "Save light meter captures and converted negatives to your Photos library."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "meter",
              "title": "Light Meter",
              "icon": "symbol:camera.aperture",
              "params": {
                "href": "/more/meter"
              }
            },
            {
              "id": "border",
              "title": "Border",
              "icon": "symbol:square.dashed",
              "params": {
                "href": "/more/border"
              }
            },
            {
              "id": "exposure",
              "title": "Exposure",
              "icon": "symbol:plusminus",
              "params": {
                "href": "/more/exposure"
              }
            },
            {
              "id": "reciprocity",
              "title": "Reciprocity",
              "icon": "symbol:timer",
              "params": {
                "href": "/more/reciprocity"
              }
            }
          ]
        }
      ],
      "./plugins/with-app-intents",
      "./plugins/with-ios-scene-lifecycle",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo from your library to attach to a film log shot or to convert a negative to a positive.",
          "cameraPermission": "Dorkroom uses the camera to meter the light in your scene and to photograph negatives for the inverter."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e81d817d-4794-41d4-a2da-e1564e7147be"
      }
    },
    "owner": "narrowstacks-org"
  }
}
