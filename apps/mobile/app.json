{
  "expo": {
    "name": "Dorkroom",
    "slug": "dorkroom",
    "scheme": "dorkroom",
    "version": "2026.7.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "art.dorkroom.mobile",
      "deploymentTarget": "26.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSCameraUsageDescription": "Dorkroom uses the camera to meter the light in your scene and to photograph negatives for the inverter.",
        "NSPhotoLibraryUsageDescription": "Choose a photo from your library to attach to a film log shot or to convert a negative to a positive.",
        "NSPhotoLibraryAddUsageDescription": "Save light meter captures and converted negatives to your Photos library."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "meter",
              "title": "Light Meter",
              "icon": "symbol:camera.aperture",
              "params": {
                "href": "/more/meter"
              }
            },
            {
              "id": "border",
              "title": "Border",
              "icon": "symbol:square.dashed",
              "params": {
                "href": "/more/border"
              }
            },
            {
              "id": "exposure",
              "title": "Exposure",
              "icon": "symbol:plusminus",
              "params": {
                "href": "/more/exposure"
              }
            },
            {
              "id": "reciprocity",
              "title": "Reciprocity",
              "icon": "symbol:timer",
              "params": {
                "href": "/more/reciprocity"
              }
            }
          ]
        }
      ],
      "./plugins/with-app-intents",
      "./plugins/with-ios-scene-lifecycle",
      "./plugins/with-ios-status-bar-forwarding",
      "./plugins/with-widget-interaction-hold",
      "./plugins/with-local-notifications-only",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo from your library to attach to a film log shot or to convert a negative to a positive.",
          "cameraPermission": "Dorkroom uses the camera to meter the light in your scene and to photograph negatives for the inverter."
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dorkroom saves your location with a frame only when you tap Add location. It is kept with your film log on this iPhone and leaves it only if you export or share that log.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/cue-stage.wav",
            "./assets/sounds/cue-agitate.wav"
          ]
        }
      ],
      "./plugins/with-widget-controls",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "art.dorkroom.mobile.widgets",
          "groupIdentifier": "group.art.dorkroom.mobile",
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": [
            {
              "name": "RollWidget",
              "displayName": "Roll in the camera",
              "description": "The roll the meter logs to: its film, EI, camera and how many frames you have shot.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "LastResultWidget",
              "displayName": "Last answers",
              "description": "The last answer from Camera Exposure and Lenses.",
              "ios": {
                "supportedFamilies": ["systemSmall", "accessoryRectangular"]
              }
            },
            {
              "name": "TimerWidget",
              "displayName": "Process timer",
              "description": "The current stage and the time left while a run is going, or the last run.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e81d817d-4794-41d4-a2da-e1564e7147be"
      }
    },
    "owner": "narrowstacks-org"
  }
}
