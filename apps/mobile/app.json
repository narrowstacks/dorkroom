{
  "expo": {
    "name": "Dorkroom",
    "slug": "dorkroom",
    "scheme": "dorkroom",
    "version": "2026.7.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "art.dorkroom.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Dorkroom uses the camera to meter the light in your scene.",
        "NSPhotoLibraryUsageDescription": "Attach a photo from your library to a shot in your film log.",
        "NSPhotoLibraryAddUsageDescription": "Save photos captured with the light meter to your Photos library."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "meter",
              "title": "Light Meter",
              "icon": "symbol:camera.aperture",
              "params": {
                "href": "/more/meter"
              }
            },
            {
              "id": "border",
              "title": "Border",
              "icon": "symbol:square.dashed",
              "params": {
                "href": "/more/border"
              }
            },
            {
              "id": "exposure",
              "title": "Exposure",
              "icon": "symbol:plusminus",
              "params": {
                "href": "/more/exposure"
              }
            },
            {
              "id": "reciprocity",
              "title": "Reciprocity",
              "icon": "symbol:timer",
              "params": {
                "href": "/more/reciprocity"
              }
            }
          ]
        }
      ],
      "./plugins/with-app-intents",
      "./plugins/with-ios-scene-lifecycle",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a photo from your library to a shot in your film log."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e81d817d-4794-41d4-a2da-e1564e7147be"
      }
    },
    "owner": "narrowstacks-org"
  }
}
