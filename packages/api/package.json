{
  "name": "@dorkroom/api",
  "version": "2026.10.30",
  "license": "MIT",
  "description": "API client and type definitions for the Dorkroom analog photography calculator",
  "keywords": [
    "photography",
    "analog",
    "film",
    "darkroom",
    "api",
    "typescript",
    "film-development",
    "dorkroom"
  ],
  "homepage": "https://dorkroom.art",
  "bugs": {
    "url": "https://github.com/narrowstacks/dorkroom/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narrowstacks/dorkroom.git",
    "directory": "packages/api"
  },
  "author": "Aaron F. Anderson <aaron@affords.art>",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "node ../../node_modules/typescript-7/bin/tsc --project tsconfig.lib.json",
    "lint": "oxlint && bun fmt --check",
    "test": "vitest run",
    "typecheck": "bun check"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
