{
  "compilerOptions": {
    // Held on TS6 options on purpose: @vercel/node compiles this tree with
    // the project's `typescript` (6.x), not the 7.x used for build/typecheck.
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "outDir": "./dist",
    "declaration": true,
    "rootDir": "../",
    "baseUrl": "../",
    "jsx": "react-jsx",
    "types": ["node"],
    // es2023 for the logic source the OG card and meta functions import
    // (`toSorted`); Node 24 and the edge runtime both ship it.
    "lib": ["es2023", "dom"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  // The calculator share cards import @dorkroom/logic's pure modules from
  // source (see utils/calculatorShare.ts). Hooks are left out on purpose: a
  // function that reached one would fail here (TS6307) rather than ship React.
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "openapi-spec.json",
    "../utils/**/*.ts",
    "../packages/logic/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "dist",
    "../node_modules",
    "../**/*.test.ts",
    "../**/__mocks__/**",
    "../**/__tests__/**",
    "../packages/logic/src/index.ts",
    "../packages/logic/src/hooks/**",
    "../packages/logic/src/test-setup.ts"
  ],
  "references": []
}
