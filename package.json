    "@swc/core": "~1.16.20",
    "@swc/helpers": "~0.5.23",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.31",
    "happy-dom": "21.0.4",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "react-doctor": "0.9.18",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "tslib": "^2.3.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "8.3.5",
