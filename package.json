{
  "name": "@dorkroom/source",
  "version": "2026.09.22",
  "license": "AGPL-3.0-only",
  "scripts": {
    "supabase:login": "bunx supabase login",
    "supabase:link": "bunx supabase link",
    "supabase:status": "bunx supabase status",
    "supabase:deploy": "bunx supabase functions deploy films --no-verify-jwt && bunx supabase functions deploy developers --no-verify-jwt && bunx supabase functions deploy combinations --no-verify-jwt && bunx supabase functions deploy stats --no-verify-jwt",
    "supabase:deploy:films": "bunx supabase functions deploy films --no-verify-jwt",
    "supabase:deploy:developers": "bunx supabase functions deploy developers --no-verify-jwt",
    "supabase:deploy:combinations": "bunx supabase functions deploy combinations --no-verify-jwt",
    "supabase:deploy:stats": "bunx supabase functions deploy stats --no-verify-jwt",
    "supabase:serve": "bunx supabase functions serve",
    "keys:create": "bun run scripts/unkey-keys.ts create",
    "keys:tier": "bun run scripts/unkey-keys.ts tier",
    "keys:anon-bootstrap": "bun run scripts/unkey-keys.ts anon-bootstrap",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "build": "turbo run build",
    "verify:legacy": "turbo run build --filter=@dorkroom/dorkroom && bun run scripts/verify-legacy-build.ts",
    "dev": "turbo run dev --filter=@dorkroom/dorkroom",
    "test": "turbo run lint test build typecheck typecheck:api test:serverless test:docs doctor --filter='@dorkroom/*' --filter='//'",
    "test:unit": "turbo run test --filter='@dorkroom/*' -- --passWithNoTests",
    "test:serverless": "vitest run --config vitest.config.ts --project serverless",
    "test:docs": "vitest run --config vitest.config.ts --project docs",
    "typecheck:api": "node node_modules/typescript/bin/tsc --noEmit --project api/tsconfig.json",
    "doctor": "react-doctor -y --blocking warning --no-telemetry",
    "lint": "oxlint api utils scripts tools postcss.config.js vitest.config.ts && biome check --linter-enabled=false api utils scripts tools supabase docs .github .vscode postcss.config.js vitest.config.ts .oxlintrc.json biome.json doctor.config.json package.json renovate.json tsconfig.base.json tsconfig.json turbo.json vercel.json",
    "lint:fix": "oxlint --fix api utils scripts tools postcss.config.js vitest.config.ts && biome check --linter-enabled=false --write api utils scripts tools supabase docs .github .vscode postcss.config.js vitest.config.ts .oxlintrc.json biome.json doctor.config.json package.json renovate.json tsconfig.base.json tsconfig.json turbo.json vercel.json",
    "lint:types": "oxlint --type-aware",
    "format": "biome format --write ."
  },
  "private": true,
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
