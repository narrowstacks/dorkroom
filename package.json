    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.22",
    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-vite-plugin": "^1.167.48",
    "@unkey/api": "^2.5.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/microfrontends": "^2.4.2",
    "@vercel/node": "^5.10.2",
    "@vercel/og": "^0.11.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@oxlint/plugins": "1.89.0",
    "@swc-node/register": "~1.12.1",
