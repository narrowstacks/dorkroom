{
  "name": "@dorkroom/source",
  "version": "2026.10.29",
  "license": "AGPL-3.0-only",
  "scripts": {
    "supabase:login": "bunx supabase login",
    "supabase:link": "bunx supabase link",
    "supabase:status": "bunx supabase status",
    "supabase:deploy": "bunx supabase functions deploy films --no-verify-jwt && bunx supabase functions deploy developers --no-verify-jwt && bunx supabase functions deploy combinations --no-verify-jwt && bunx supabase functions deploy stats --no-verify-jwt",
    "supabase:deploy:films": "bunx supabase functions deploy films --no-verify-jwt",
    "supabase:deploy:developers": "bunx supabase functions deploy developers --no-verify-jwt",
    "supabase:deploy:combinations": "bunx supabase functions deploy combinations --no-verify-jwt",
    "supabase:deploy:stats": "bunx supabase functions deploy stats --no-verify-jwt",
    "supabase:serve": "bunx supabase functions serve",
    "keys:create": "bun run scripts/unkey-keys.ts create",
    "keys:tier": "bun run scripts/unkey-keys.ts tier",
    "keys:anon-bootstrap": "bun run scripts/unkey-keys.ts anon-bootstrap",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "build": "turbo run build",
    "verify:legacy": "turbo run build --filter=@dorkroom/dorkroom && bun run scripts/verify-legacy-build.ts",
    "dev": "turbo run dev --filter=@dorkroom/dorkroom",
    "test": "turbo run lint lint:root test build typecheck typecheck:api typecheck:tools test:serverless test:docs doctor --filter='@dorkroom/*' --filter='//'",
    "test:unit": "turbo run test --filter='@dorkroom/*' -- --passWithNoTests",
    "test:serverless": "vitest run --config vitest.config.ts --project serverless",
    "test:docs": "vitest run --config vitest.config.ts --project docs",
    "typecheck:api": "node node_modules/typescript/bin/tsc --noEmit --project api/tsconfig.json",
    "typecheck:tools": "bun check -p tsconfig.tools.json",
    "doctor": "react-doctor -y --blocking warning --no-telemetry",
    "lint": "oxlint && bun fmt --check",
    "lint:fix": "oxlint --fix && bun fmt",
    "lint:root": "oxlint api utils scripts tools supabase postcss.config.js vitest.config.ts && bun fmt --check api utils scripts tools supabase .vscode postcss.config.js vitest.config.ts .oxlintrc.json .prettierrc.json doctor.config.json package.json renovate.json tsconfig.base.json tsconfig.json tsconfig.tools.json turbo.json vercel.json",
    "lint:types": "oxlint --type-aware",
    "format": "bun fmt"
  },
  "private": true,
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@unkey/api": "^2.5.4",
    "@vercel/microfrontends": "^2.4.2",
    "@vercel/node": "^5.10.2",
    "@vercel/og": "^0.11.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "react": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.31",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "^8.5.31",
    "react-doctor": "0.9.18",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "optionalDependencies": {
    "supabase": "^2.107.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "vite": "8.1.6"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ]
}
